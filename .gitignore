# Ignore everything by default
*

# Node-RED palette package
!node-red-contrib-abb-gofa/
!node-red-contrib-abb-gofa/**
# ...but not generated/internal files inside it
node-red-contrib-abb-gofa/.claude/
node-red-contrib-abb-gofa/node_modules/
node-red-contrib-abb-gofa/package-lock.json

# Node-RED flows
!flows/
!flows/gofa_demo_flow.json
!flows/teach_flow.json
!flows/setup_flow.json
!flows/pickplace_sorting_flow.json
!flows/watchdog_flow.json
!flows/mqtt_bridge_flow.json
!flows/egm_conveyor_demo_flow.json
!flows/brake_check_reminder_flow.json
# Local-only Thai-annotated learning copies — not synced to npm/GitHub, stay out of git
# (already caught by the top-level "*" ignore-all; listed here explicitly for clarity)
flows/pickplace_sorting_flow_th.json
flows/teach_flow_th.json

# RAPID program
!rapid/
!rapid/MainModule.mod
!rapid/MainModuleEGM.mod
!rapid/BackgroundLed.mod

# User docs (getting-started/reference/troubleshooting) + per-subsystem internals
!docs/
!docs/**
# ...except vendor manuals converted to Markdown. These are ABB's copyrighted
# documentation ("© Copyright ABB, All rights reserved"), not this project's writing,
# and this is a public repo — converting a manual to .md does not make it ours to
# redistribute. Keep local copies for reference; they stay out of git.
# Anything this project learns FROM a manual belongs in our own docs, in our own words,
# with the live-verified evidence (see docs/transport-internals.md for the pattern).
docs/*Operating_manual*.md
docs/*Product_manual*.md
docs/*Application_manual*.md
docs/*Product_specification*.md
docs/OmniCore_C30_AddIns_ModbusTCP_CollaborativeFeatures.md
docs/_raw_text.txt

# This file, README, changelog, license, CI, and Claude Code project config
!.gitignore
!README.md
!CHANGELOG.md
!LICENSE
!CLAUDE.md
!MANUAL_CONTROL.md
!.github/
!.github/**
!/.claude/
!/.claude/**
# ...except local machine settings (permission allowlist, local paths) — not for a public repo
/.claude/settings.local.json
# ...and Claude Code's own runtime session-lock file (pid/timestamp, not project content)
/.claude/scheduled_tasks.lock
